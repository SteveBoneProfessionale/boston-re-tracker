data/*.jsonl

# Claude config
.claude/

# OS
.DS_Store
Thumbs.db
data/boston_re.db.bak-*

# Downloaded plan sets: a rebuildable cache, 1.1 GB. scraper/ri_planset_llm.py
# re-fetches anything missing from data/ri_plansets/cpc_urls.txt.
data/ri_plansets/*.pdf

# Generated read-only acquisitions database is COMMITTED (see
# scripts/export_acquisitions_db.py); only its temp artefacts are ignored.
data/acquisitions.db-journal
data/acquisitions.db-wal
data/acquisitions.db-shm
data/acquisitions.db.tmp

# South Florida: the rejected-permit dump is a 19 MB debug artefact listing
# every City of Miami permit row the three tests dropped. Rebuildable by
# re-running scraper/sofl_miami.py; the counts and the reasons that matter are
# summarised in south_florida_log.md.
data/sofl_miami_rejected.json
